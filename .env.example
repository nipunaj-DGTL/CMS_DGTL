CMS_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/dgtl_cms
CMS_PUBLIC_URL=http://localhost:3000
PAYLOAD_SECRET=replace-with-at-least-32-random-characters
CMS_PREVIEW_SIGNING_SECRET=replace-with-a-separate-preview-secret
CMS_EMAIL_PROVIDER=resend
CMS_EMAIL_FROM_ADDRESS=cms@dgtl.lk
CMS_EMAIL_FROM_NAME=DGTL CMS
RESEND_API_KEY=replace-with-resend-api-key
CMS_WEBSITE_READ_TOKENS={"client-01-main":"local-client-01-read-token","client-02-main":"local-client-02-read-token","client-03-main":"local-client-03-read-token","client-04-main":"local-client-04-read-token"}
CMS_REVALIDATION_SECRETS={"client-01-main":"local-client-01-revalidation-secret","client-02-main":"local-client-02-revalidation-secret","client-03-main":"local-client-03-revalidation-secret","client-04-main":"local-client-04-revalidation-secret"}
CMS_ALLOWED_ORIGINS=http://localhost:3101,http://localhost:3102,http://localhost:3103,http://localhost:3104
SEED_ADMIN_EMAIL=admin@example.test
SEED_ADMIN_PASSWORD=replace-with-a-local-password

# Reusable website deployment (select one client per deployment)
CMS_URL=http://localhost:3000
CMS_WEBSITE_KEY=client-01-main
CMS_READ_TOKEN=local-client-01-read-token
CMS_REVALIDATION_SECRET=local-client-01-revalidation-secret
CMS_PREVIEW_SECRET=replace-with-a-separate-preview-secret
NEXT_PUBLIC_SITE_URL=http://localhost:3101
