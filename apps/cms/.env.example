CMS_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/dgtl_cms
CMS_PUBLIC_URL=http://localhost:3000
PAYLOAD_SECRET=replace-with-at-least-32-random-characters
CMS_PREVIEW_SIGNING_SECRET=replace-with-a-separate-preview-secret
CMS_EMAIL_PROVIDER=resend
CMS_EMAIL_FROM_ADDRESS=cms@mail.dgtl.lk
CMS_EMAIL_FROM_NAME=DGTL CMS
RESEND_API_KEY=replace-with-resend-api-key
CMS_WEBSITE_READ_TOKENS={"client-01-main":"replace-me","client-02-main":"replace-me","client-03-main":"replace-me","client-04-main":"replace-me"}
CMS_REVALIDATION_SECRETS={"client-01-main":"replace-me","client-02-main":"replace-me","client-03-main":"replace-me","client-04-main":"replace-me"}
CMS_ALLOWED_ORIGINS=http://localhost:3101,http://localhost:3102,http://localhost:3103,http://localhost:3104
SEED_ADMIN_EMAIL=admin@example.test
SEED_ADMIN_PASSWORD=replace-with-a-local-password

# Optional DGTL Service SSO. Real values belong only in an ignored local env file.
CMS_SSO_ENABLED=false
CMS_SSO_REQUIRED=false
CMS_SSO_ISSUER=https://replace-with-project.supabase.co/auth/v1
CMS_SSO_CLIENT_ID=replace-with-separate-cms-oauth-client-id
CMS_SSO_CLIENT_SECRET=replace-with-cms-oauth-client-secret
CMS_SSO_VIEWER_URL=https://replace-with-service-backend-host/v1/me
CMS_SSO_ENCRYPTION_KEY=
CMS_SSO_RECOVERY_USER_ID=
