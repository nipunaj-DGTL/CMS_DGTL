diff --git a/src/lib/oauth-policy.ts b/src/lib/oauth-policy.ts
index f266f0e..3c0e1d4 100644
--- a/src/lib/oauth-policy.ts
+++ b/src/lib/oauth-policy.ts
@@ -17,3 +17,31 @@ export function allowedSeoScopes(scope: string): boolean {
   const scopes = scope.split(/\s+/).filter(Boolean)
   return scopes.includes('openid') && scopes.every((item) => ['openid', 'email', 'profile'].includes(item))
 }
+
+export interface TrustedApplication { key: 'cms' | 'seo'; clientID: string; callbacks: string }
+
+export function trustedApplications(env: Record<string, string | undefined>): TrustedApplication[] {
+  const applications: TrustedApplication[] = []
+  const seenCallbacks = new Set<string>()
+  const seenClients = new Set<string>()
+  for (const key of ['cms', 'seo'] as const) {
+    const clientID = env[`DGTL_OAUTH_${key.toUpperCase()}_CLIENT_ID`]
+    const callbacks = env[`DGTL_OAUTH_${key.toUpperCase()}_CALLBACK_URLS`]
+    if (!clientID && !callbacks) continue
+    if (!clientID || !callbacks || seenClients.has(clientID)) throw new Error('Invalid OAuth application configuration')
+    seenClients.add(clientID)
+    for (const callback of callbacks.split(',').map((item) => item.trim())) {
+      if (!allowedSeoCallback(callback, callback)) throw new Error('Invalid OAuth callback configuration')
+      const normalized = new URL(callback).href
+      if (seenCallbacks.has(normalized)) throw new Error('OAuth callbacks must belong to exactly one application')
+      seenCallbacks.add(normalized)
+    }
+    applications.push({ key, clientID, callbacks })
+  }
+  return applications
+}
+
+export function approvedApplication(apps: TrustedApplication[], callback: string, clientID?: string) {
+  const matches = apps.filter((app) => (clientID === undefined || app.clientID === clientID) && allowedSeoCallback(callback, app.callbacks))
+  return matches.length === 1 ? matches[0] : undefined
+}
