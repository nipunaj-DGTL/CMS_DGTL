diff --git a/tests/cms-sso.test.mjs b/tests/cms-sso.test.mjs
new file mode 100644
--- /dev/null
+++ b/tests/cms-sso.test.mjs
@@ -0,0 +1,28 @@
+import assert from 'node:assert/strict'
+import { test } from 'node:test'
+import { trustedApplications, approvedApplication } from '../src/lib/oauth-policy.ts'
+import { getDashboardServices } from '../src/lib/service-catalog.ts'
+
+const env = {
+  DGTL_OAUTH_CMS_CLIENT_ID: 'cms-client', DGTL_OAUTH_CMS_CALLBACK_URLS: 'https://cms.dgtl.lk/sso/callback',
+  DGTL_OAUTH_SEO_CLIENT_ID: 'seo-client', DGTL_OAUTH_SEO_CALLBACK_URLS: 'https://seo.dgtl.lk/callback',
+}
+test('CMS launch always establishes the current central identity', () => {
+  const result = getDashboardServices([{ key: 'cms', name: 'CMS', description: '', url: 'https://cms.dgtl.lk/admin' }])
+  assert.equal(result[0].url, 'https://cms.dgtl.lk/sso')
+})
+test('CMS and SEO use separate exact client/callback bindings', () => {
+  const apps = trustedApplications(env)
+  assert.equal(approvedApplication(apps, env.DGTL_OAUTH_CMS_CALLBACK_URLS, 'cms-client').key, 'cms')
+  assert.equal(approvedApplication(apps, env.DGTL_OAUTH_CMS_CALLBACK_URLS, 'seo-client'), undefined)
+  assert.equal(approvedApplication(apps, `${env.DGTL_OAUTH_CMS_CALLBACK_URLS}?code=single-use`).key, 'cms')
+  assert.equal(approvedApplication(apps, 'https://evil.test/sso/callback'), undefined)
+})
+test('ambiguous registrations and partial configuration fail closed', () => {
+  assert.throws(() => trustedApplications({ ...env, DGTL_OAUTH_CMS_CLIENT_ID: 'seo-client' }))
+  assert.throws(() => trustedApplications({ ...env, DGTL_OAUTH_CMS_CALLBACK_URLS: env.DGTL_OAUTH_SEO_CALLBACK_URLS }))
+  assert.throws(() => trustedApplications({ DGTL_OAUTH_CMS_CLIENT_ID: 'cms-client' }))
+})
+test('existing SEO-only registration remains valid', () => {
+  assert.deepEqual(trustedApplications({ DGTL_OAUTH_SEO_CLIENT_ID: 'seo', DGTL_OAUTH_SEO_CALLBACK_URLS: env.DGTL_OAUTH_SEO_CALLBACK_URLS }).map(a => a.key), ['seo'])
+})
