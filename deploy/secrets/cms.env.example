# Password must match POSTGRES_APP_PASSWORD in postgres.env.
CMS_DATABASE_URL=postgresql://dgtl_app:replace-with-the-cms-runtime-url-password@postgres:5432/dgtl_cms
CMS_PUBLIC_URL=https://cms.dgtl.lk
PAYLOAD_SECRET=replace-with-at-least-32-random-characters
CMS_PREVIEW_SIGNING_SECRET=replace-with-a-separate-random-secret
CMS_EMAIL_PROVIDER=resend
CMS_EMAIL_FROM_ADDRESS=cms@mail.dgtl.lk
CMS_EMAIL_FROM_NAME=DGTL CMS
RESEND_API_KEY=replace-with-a-restricted-resend-api-key
# Empty CMS-only deployment. Add per-website, distinct random secrets when onboarding.
CMS_WEBSITE_READ_TOKENS={}
CMS_REVALIDATION_SECRETS={}
CMS_ALLOWED_ORIGINS=
PAYLOAD_DB_PUSH=false

# Cloudflare R2 (or another private S3-compatible store). Create a narrowly
# scoped token for only this bucket, keep public bucket access disabled, and
# configure tested off-site media recovery. R2 does not support S3 bucket
# versioning; use a separate archive retaining overwritten/deleted objects.
CMS_MEDIA_STORAGE=s3
CMS_MEDIA_BUCKET=dgtl-production-media
CMS_MEDIA_ENDPOINT=https://replace-with-account-id.r2.cloudflarestorage.com
CMS_MEDIA_ACCESS_KEY_ID=replace-me
CMS_MEDIA_SECRET_ACCESS_KEY=replace-me
CMS_MEDIA_REGION=auto
CMS_MEDIA_FORCE_PATH_STYLE=false

# The self-hosted Compose override provides `clamav`. For a managed scanner,
# replace CLAMAV_HOST with its private DNS name. Never expose port 3310 publicly.
CMS_MEDIA_SCAN_MODE=clamav
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=15000

# DGTL dashboard SSO: keep disabled until the migration, mapping and live test pass.
CMS_SSO_ENABLED=false
CMS_SSO_REQUIRED=false
CMS_SSO_ISSUER=https://replace-with-project.supabase.co/auth/v1
CMS_SSO_CLIENT_ID=replace-with-separate-cms-oauth-client-id
CMS_SSO_CLIENT_SECRET=replace-with-cms-oauth-client-secret
CMS_SSO_VIEWER_URL=https://replace-with-service-backend-host/v1/me
# Generate 32 random bytes encoded as 64 hexadecimal characters; not PAYLOAD_SECRET.
CMS_SSO_ENCRYPTION_KEY=
# Optional UNLINKED company-super-admin numeric ID for recovery in strict mode.
CMS_SSO_RECOVERY_USER_ID=
