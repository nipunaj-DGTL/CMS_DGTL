# Runtime API traffic stays on the private Compose network. The image workflow
# still builds Next.js image allowlists with the public https://cms.dgtl.lk URL.
CMS_URL=http://cms:3000
CMS_WEBSITE_KEY=client-01-main
CMS_READ_TOKEN=replace-with-client-01-read-token
CMS_REVALIDATION_SECRET=replace-with-client-01-revalidation-secret
CMS_PREVIEW_SECRET=replace-with-the-current-cms-preview-signing-secret
NEXT_PUBLIC_SITE_URL=https://client01.dgtl.lk
