# Password must match POSTGRES_MIGRATOR_PASSWORD in postgres.env. The bootstrap
# owner credential is never provided to this container.
CMS_DATABASE_URL=postgresql://dgtl_migrator:replace-with-the-migration-url-password@postgres:5432/dgtl_cms
CMS_PUBLIC_URL=https://cms.dgtl.lk
PAYLOAD_SECRET=replace-with-the-same-runtime-payload-secret
CMS_PREVIEW_SIGNING_SECRET=replace-with-the-same-preview-secret
CMS_EMAIL_PROVIDER=resend
CMS_EMAIL_FROM_ADDRESS=cms@dgtl.lk
CMS_EMAIL_FROM_NAME=DGTL CMS
RESEND_API_KEY=replace-with-the-same-restricted-resend-api-key
CMS_WEBSITE_READ_TOKENS={"client-01-main":"replace-me","client-02-main":"replace-me"}
CMS_REVALIDATION_SECRETS={"client-01-main":"replace-me","client-02-main":"replace-me"}
CMS_ALLOWED_ORIGINS=https://client01.dgtl.lk,https://dgtl.lk,https://www.dgtl.lk
PAYLOAD_DB_PUSH=false
CMS_MEDIA_STORAGE=s3
CMS_MEDIA_BUCKET=dgtl-production-media
CMS_MEDIA_ENDPOINT=https://replace-with-account-id.r2.cloudflarestorage.com
CMS_MEDIA_ACCESS_KEY_ID=replace-me
CMS_MEDIA_SECRET_ACCESS_KEY=replace-me
CMS_MEDIA_REGION=auto
CMS_MEDIA_FORCE_PATH_STYLE=false
CMS_MEDIA_SCAN_MODE=clamav
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=15000
