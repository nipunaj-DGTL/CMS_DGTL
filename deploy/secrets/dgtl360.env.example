# Runtime API traffic stays private; CMS_PUBLIC_URL controls browser-visible
# media URLs and the image is built with the public CMS origin allowlisted.
CMS_URL=http://cms:3000
CMS_WEBSITE_KEY=client-02-main
CMS_READ_TOKEN=replace-with-client-02-read-token
CMS_REVALIDATION_SECRET=replace-with-client-02-revalidation-secret
CMS_PREVIEW_SECRET=replace-with-the-current-cms-preview-signing-secret
CMS_REQUEST_TIMEOUT_MS=5000
CMS_ALLOW_LOCAL_FALLBACK=false
SITE_URL=https://dgtl.lk
RESEND_API_KEY=replace-with-a-restricted-dgtl360-resend-api-key
ENQUIRY_FROM_EMAIL=DGTL 360 Website <website@dgtl.lk>
ENQUIRY_TO_EMAIL=info@dgtl.lk
