# Data-only template. Replace placeholders with reviewed values and signed
# image digests. No real server has been provisioned by this file.
COMPOSE_PROJECT_NAME=dgtl-cms-staging
DEPLOYMENT_SCOPE=cms-only
TOOLING_GIT_SHA=0000000000000000000000000000000000000000
SOURCE_REPOSITORY=nipunaj-DGTL/CMS_DGTL
SOURCE_GIT_SHA=0000000000000000000000000000000000000000
IMAGE_REPOSITORY_PREFIX=ghcr.io/nipunaj-dgtl
IMAGE_BUILD_VARIANT=staging
IMAGE_CMS_PUBLIC_URL=https://cms-staging.dgtl.lk
SECRETS_DIR=/opt/dgtl/secrets
SELF_HOSTED_POSTGRES=true
ENABLE_CADDY=true
BACKUP_CONFIRMED=false
BACKUP_REFERENCE=replace-with-recovery-reference
OBJECT_STORAGE_CHECKPOINT_CONFIRMED=false
OBJECT_STORAGE_CHECKPOINT_REFERENCE=replace-with-verified-media-backup-reference
CMS_WEB_IMAGE=ghcr.io/nipunaj-dgtl/dgtl-cms-web@sha256:replace-me
CMS_WORKER_IMAGE=ghcr.io/nipunaj-dgtl/dgtl-cms-worker@sha256:replace-me
CMS_MIGRATE_IMAGE=ghcr.io/nipunaj-dgtl/dgtl-cms-migrate@sha256:replace-me
POSTGRES_IMAGE=docker.io/library/postgres@sha256:replace-me
CLAMAV_IMAGE=docker.io/clamav/clamav@sha256:replace-me
CADDY_IMAGE=docker.io/library/caddy@sha256:replace-me
ACME_EMAIL=ops@dgtl.lk
CMS_HOSTNAME=cms-staging.dgtl.lk
CMS_ORIGIN=https://cms-staging.dgtl.lk
