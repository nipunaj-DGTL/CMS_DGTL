# Copy to an immutable release manifest such as releases/2026-09T120000Z.env.
# Production deploy scripts reject mutable tags; replace every value with the
# exact digest emitted by the image workflow.
COMPOSE_PROJECT_NAME=dgtl-platform
DEPLOYMENT_SCOPE=cms-only
# Exact commit whose deploy/ directory is installed under /opt/dgtl/tooling.
TOOLING_GIT_SHA=0000000000000000000000000000000000000000
# Exact repository/commit recorded in every application image attestation.
SOURCE_REPOSITORY=your-org/cms-test-project
SOURCE_GIT_SHA=0000000000000000000000000000000000000000
IMAGE_REPOSITORY_PREFIX=ghcr.io/your-org
IMAGE_BUILD_VARIANT=production
IMAGE_CMS_PUBLIC_URL=https://cms.dgtl.lk
SECRETS_DIR=/opt/dgtl/secrets
SELF_HOSTED_POSTGRES=true
ENABLE_CADDY=true
# For a managed database, set SELF_HOSTED_POSTGRES=false and set this only after
# the provider recovery point is verified.
BACKUP_CONFIRMED=false
BACKUP_REFERENCE=replace-with-provider-pitr-or-snapshot-id
# Required for every release because media lives in private object storage.
# Use a provider backup/versioning event, immutable audit record, or operations
# ticket that lets an operator identify the matching media recovery point.
OBJECT_STORAGE_CHECKPOINT_CONFIRMED=false
OBJECT_STORAGE_CHECKPOINT_REFERENCE=replace-with-provider-checkpoint-or-ticket

CMS_WEB_IMAGE=ghcr.io/your-org/dgtl-cms-web@sha256:replace-me
CMS_WORKER_IMAGE=ghcr.io/your-org/dgtl-cms-worker@sha256:replace-me
CMS_MIGRATE_IMAGE=ghcr.io/your-org/dgtl-cms-migrate@sha256:replace-me
# Resolve and review these upstream images, then pin the exact registry digest.
POSTGRES_IMAGE=docker.io/library/postgres@sha256:replace-me
CLAMAV_IMAGE=docker.io/clamav/clamav@sha256:replace-me
CADDY_IMAGE=docker.io/library/caddy@sha256:replace-me

ACME_EMAIL=ops@dgtl.lk
CMS_HOSTNAME=cms.dgtl.lk

CMS_ORIGIN=https://cms.dgtl.lk

# Optional full-stack hosting requires DEPLOYMENT_SCOPE=full-stack and every
# demo setting below. Separate customer frontends never need these variables.
# IMAGE_CLIENT01_SITE_URL=https://client01.dgtl.lk
# IMAGE_DGTL360_SITE_URL=https://dgtl.lk
# CLIENT01_IMAGE=ghcr.io/your-org/dgtl-client01@sha256:replace-me
# DGTL360_IMAGE=ghcr.io/your-org/dgtl360@sha256:replace-me
# CLIENT01_HOSTNAME=client01.dgtl.lk
# DGTL360_HOSTNAME=dgtl.lk
# DGTL360_WWW_HOSTNAME=www.dgtl.lk
# CLIENT01_ORIGIN=https://client01.dgtl.lk
# DGTL360_ORIGIN=https://dgtl.lk
# CLIENT01_WEBSITE_KEY=client-01-main
# DGTL360_WEBSITE_KEY=client-02-main
